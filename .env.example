# Copy to .env.local and fill in real values. Never commit real secrets.

# Neon Postgres connection string (use the dev branch locally).
# Used by the app at runtime and by drizzle-kit (db:migrate, db:push, db:studio).
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Clerk publishable key (safe to expose to the browser). From the Clerk dashboard, API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Clerk secret key (server only). From the Clerk dashboard, API keys.
CLERK_SECRET_KEY=sk_test_replace_me

# Clerk webhook signing secret (server only), for /api/webhooks/clerk, which
# keeps each account's name and email in step with Clerk and deletes the
# account (and everything under it: classes and their students, and
# self-learner readings) when the Clerk account is deleted.
# Create the endpoint in the Clerk dashboard: Configure, Webhooks, Add
# endpoint; URL https://<your domain>/api/webhooks/clerk; subscribe to
# user.created, user.updated, and user.deleted; then copy its Signing
# Secret (starts with whsec_) here. One per Clerk instance (development and
# production each have their own). Without it the route refuses every
# delivery with a 500 and logs an error; the app still works, since accounts
# are also created on their first visit.
CLERK_WEBHOOK_SIGNING_SECRET=

# Paths of the in-app Clerk sign-in and sign-up pages (teachers and
# self-learners; students never sign in). They are our own pages
# (src/app/sign-in and src/app/sign-up, with Clerk's <SignIn /> and
# <SignUp />), not Clerk's hosted pages. The landing page's "Get started"
# opens /sign-up and "Sign in" opens /sign-in. The code passes the same
# paths (src/lib/auth-routes.ts), so these are a backup: keep them as they
# are. No Clerk dashboard change is needed.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Where sign-in and sign-up land when there is no page to go back to.
# /home sends each account to its home: /welcome for a new account (choose
# teacher or self-learner), /teacher, or /learn; a deleted account is sent
# to /account-deleted. The code passes /home too, so keep these /home.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/home
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/home

# AI: question generation and the effort check call Claude through Vercel
# AI Gateway (server only).
# On Vercel: enable AI Gateway for the project. Deployments authenticate
# with the project's OIDC token, which Vercel sends with each request, so
# nothing needs to be set here. OIDC alone, without AI Gateway enabled for
# the project, gets 401s (question writing shows as not set up).
# Local dev, either:
#   - run `vercel link`, then `vercel env pull` (writes the project's
#     Development env vars, VERCEL_OIDC_TOKEN included, to .env.local). The
#     token expires after 12 hours: pull again, or run the app with
#     `vercel dev`, which refreshes it; or
#   - set AI_GATEWAY_API_KEY to an AI Gateway API key. The project owner
#     creates one at deploy (Vercel dashboard, AI Gateway, API keys). Also
#     the way to run on a host other than Vercel.
# A key, if set, always wins over OIDC (even a wrong one). With neither,
# teachers see "Question writing isn’t set up yet.", students' tries are
# given back, and the server logs what's missing.
AI_GATEWAY_API_KEY=

# Model on the gateway (optional), as creator/model. Defaults to
# anthropic/claude-sonnet-5.5. Use a current Claude model such as
# anthropic/claude-opus-5.5, anthropic/claude-sonnet-5.5, or
# anthropic/claude-haiku-5.5. The request (low effort, strict tools, auto
# tool choice) targets current 5.x models; an older model may return a 400.
# The old ANTHROPIC_MODEL is still read when AI_MODEL is unset; a bare
# Anthropic id there (claude-sonnet-5-5) becomes anthropic/claude-sonnet-5.5.
# ANTHROPIC_API_KEY is no longer used.
AI_MODEL=

# Key for hashing student IP addresses in the join rate limit (server only).
# Required in production (at least 32 characters): without it, joining fails.
# Local dev and tests fall back to a fixed dev-only key. Generate one with:
#   openssl rand -base64 32
# Rotating it only resets the join rate-limit counters.
JOIN_IP_HASH_SECRET=replace_me_with_openssl_rand_base64_32

# For the db:check scripts only (optional): how many queries each script
# keeps in flight at once (default 8), so a full run can't exhaust
# Postgres's max_connections. The checks refuse to run unless DATABASE_URL
# is local (localhost, 127.0.0.1, ::1, *.localtest.me) or names a test
# database, and ALLOW_DB_WRITES=1. Never set ALLOW_DB_WRITES in .env.local.
# DB_CHECK_CONCURRENCY=8

# Bot check on the student join form (Cloudflare Turnstile, free).
# On when BOTH keys are set. Create a widget at deploy (Cloudflare
# dashboard, Turnstile; widget mode Managed) for the app's domain and paste
# its site key and secret key here.
# Production (NODE_ENV=production or VERCEL_ENV=production): both keys are
# REQUIRED. With either one missing, every join is refused with a generic
# "We couldn't join you" message and the server logs an error naming the
# missing variable, the same fail-closed rule as JOIN_IP_HASH_SECRET.
# Local dev and tests: leave both empty and the check is off (no widget, no
# network call), or use Cloudflare's test keys below to see the widget.
# Only one key set refuses every join anywhere, so a typo can't quietly turn
# the check off.
# When on, a join whose check fails, times out (5 s), or can't reach
# Cloudflare is refused.
# For local testing, Cloudflare publishes test keys (not secrets) at
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
#   always passes:  site 1x00000000000000000000AA  secret 1x0000000000000000000000000000000AA
#   always fails:   site 2x00000000000000000000AB  secret 2x0000000000000000000000000000000AA
# Teacher sign-up is not covered by these keys. It uses Clerk's own
# "Challenge suspicious sign-ups" (Clerk Dashboard, Protect, Protections):
# on by default for new Clerk apps, free on every plan, no keys to add.
# Check its row says Active at deploy. An older app may show a legacy
# "Bot sign-up protection" row instead; enable it or take Clerk's Update.
# It challenges sign-ups only (never sign-ins), and by default only
# suspicious ones (bot-like, VPN, Tor, proxy); "All" needs Clerk's
# Business plan. See docs/v1-spec.md.
# The site key is read at build time too (NEXT_PUBLIC_), so redeploy after
# changing it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Turn the join bot check off on purpose (optional). Only the exact value 1
# counts. Outside production it just turns the check off. In production it
# is the only way to run without the keys, and every join logs a warning
# saying the check is off. Leave unset normally.
TURNSTILE_DISABLED=

# Hostnames the Turnstile token must have been solved on (optional,
# comma-separated, e.g. unpack.example.org,www.unpack.example.org). A token
# from any other hostname is refused. Unset: in production on Vercel the
# deploy's own hostnames are used (VERCEL_PROJECT_PRODUCTION_URL,
# VERCEL_BRANCH_URL, and VERCEL_URL); elsewhere the hostname isn't checked.
# Never checked with Cloudflare's test secret keys. Set it if the app is
# served on a domain Vercel doesn't report (another custom domain or alias).
# Preview: Vercel builds previews with NODE_ENV=production, so the check
# runs there too. The branch and deployment URLs are covered by the
# fallback; if previews use a custom domain, set this variable for the
# Preview environment in Vercel (Settings, Environment Variables) to that
# domain, and add it to the Turnstile widget's hostnames in Cloudflare.
TURNSTILE_EXPECTED_HOSTNAMES=
